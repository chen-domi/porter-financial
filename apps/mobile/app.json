{
  "expo": {
    "name": "Porter",
    "slug": "porter",
    "scheme": "porter",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#07090C",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dominicchen.porter",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Porter uses Face ID to keep your financial data private."
      }
    },
    "android": {
      "package": "com.dominicchen.porter"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "@clerk/expo",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07090C",
          "image": "./assets/splash-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Porter uses Face ID to keep your financial data private."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
